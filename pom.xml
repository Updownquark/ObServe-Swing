<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.quark-sw</groupId>
	<artifactId>ObServe-Swing</artifactId>
	<version>4.0.0</version>
	<name>ObServe-Swing</name>
	<description>Java Swing utilities based on ObServe observable structures</description>
	<url>https://github.com/Updownquark/ObServe-Swing</url>
	<scm>
		<connection>scm:git:git://://github.com</connection>
		<developerConnection>scm:git:ssh://github.com:updownquark/ObServe-Swing.git</developerConnection>
		<url>https://github.com/tree/main</url>
	</scm>
	<developers>
		<developer>
			<name>Andrew Butler</name>
			<email>updownquark@gmail.com</email>
			<organization>Quark Software</organization>
			<organizationUrl>https://quark-sw.com</organizationUrl>
		</developer>
	</developers>
	<licenses>
		<license>
		    <name>MIT License</name>
		    <url>https://opensource.org</url>
		    <distribution>repo</distribution>
		</license>
	</licenses>
	<dependencies>
		<dependency>
			<groupId>com.quark-sw</groupId>
			<artifactId>Qommons</artifactId>
			<version>3.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.quark-sw</groupId>
			<artifactId>ObServe</artifactId>
			<version>3.0.0</version>
		</dependency>
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
			<version>32.0.0-jre</version>
		</dependency>
		<dependency>
			<groupId>com.miglayout</groupId>
			<artifactId>miglayout-swing</artifactId>
			<version>4.2</version>
		</dependency>
		<dependency>
			<groupId>org.swinglabs</groupId>
			<artifactId>swingx</artifactId>
			<version>1.6.1</version>
		</dependency>
		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<version>4.13.2</version>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<resources>
			<resource>
				<directory>src/main/java</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
			<resource>
				<directory>src/main/resources</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</resource>
		</resources>
		<testResources>
			<testResource>
				<directory>src/test/java</directory>
				<excludes>
					<exclude>**/*.java</exclude>
				</excludes>
			</testResource>
		</testResources>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.8.1</version>
				<configuration>
					<source>1.8</source>
					<target>1.8</target>
					<useIncrementalCompilation>false</useIncrementalCompilation>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
